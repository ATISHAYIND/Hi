for profile in $(aws configure list-profiles); do
  zones=$(aws route53 list-hosted-zones --profile "$profile" \
    --query "HostedZones[?contains(Name, 'cetera')].Name" --output text 2>/dev/null)
  if [ -n "$zones" ]; then
    echo ">>> FOUND in $profile : $zones"
  fi
done




